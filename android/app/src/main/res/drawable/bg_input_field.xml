<?xml version="1.0" encoding="utf-8"?>
<!-- URL input: paper white face, thick ink outline, hard offset shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:start="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_ink" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item
        android:end="5dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_panel_alt" />
            <stroke
                android:width="3dp"
                android:color="@color/brand_ink" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
