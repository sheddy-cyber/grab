<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <!-- A vibrant 45-degree gradient blending the logo colors (Pink/Orange -> Blue) -->
            <gradient
                android:angle="45"
                android:startColor="@color/brandInstagram"
                android:centerColor="@color/brandInstagramEnd"
                android:endColor="@color/brandFacebook"
                android:type="linear" />
        </shape>
    </item>
</ripple>
