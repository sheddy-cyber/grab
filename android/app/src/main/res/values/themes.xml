<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GrabAm" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="fontFamily">sans-serif-rounded</item>
        <item name="colorPrimary">@color/brand_purple</item>
        <item name="colorPrimaryVariant">@color/brand_purple_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_coral</item>
        <item name="colorSecondaryVariant">@color/brand_coral</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/surface_background</item>
        <item name="android:statusBarColor">@color/surface_background</item>
        <item name="android:navigationBarColor">@color/surface_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.GrabAm.Transparent" parent="Theme.GrabAm">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
