<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:contentDescription="Settings"
                app:icon="@drawable/ic_settings"
                app:iconSize="24dp"
                app:iconTint="@color/brand_purple" />
        </RelativeLayout>

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/app_logo" />

        <ImageView
            android:id="@+id/ivWordmark"
            android:layout_width="280dp"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/brand_wordmark" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-rounded"
            android:text="@string/app_description"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/downloadPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            app:cardBackgroundColor="@color/surface_panel"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/outline_soft"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_url"
                    app:boxBackgroundColor="@color/surface_panel"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/brand_purple"
                    app:hintTextColor="@color/brand_purple">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-rounded"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:textColor="@color/brand_ink"
                        android:textColorHint="@color/text_muted" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownload"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-rounded"
                    android:text="@string/download"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:backgroundTint="@color/brand_purple"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPaste"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-rounded"
                        android:text="@string/paste_link"
                        android:textAllCaps="false"
                        android:textColor="@color/brand_ink"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_paste"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="@null"
                        app:strokeColor="@color/outline_soft" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddTile"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-rounded"
                        android:text="@string/add_tile_short"
                        android:textAllCaps="false"
                        android:textColor="@color/brand_ink"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_tile"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="@null"
                        app:strokeColor="@color/outline_soft" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
